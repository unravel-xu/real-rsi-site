---
import type { Project } from '../lib/catalog.mjs';
import { sitePath } from '../lib/links';
import UiIcon from './UiIcon.astro';

interface Props {
  project: Project;
  filterable?: boolean;
}
const { project, filterable = false } = Astro.props;
const { latest } = project;
const { manifest, metadata, definition } = latest;
const keywords = [definition.name, manifest.package_id, metadata.summary, metadata.category, ...metadata.tags].join(' ');
const href = sitePath(`market/${project.owner}/${project.project}/`);
---

<article
  class="package-card"
  data-market-card={filterable ? '' : undefined}
  data-category={filterable ? metadata.category : undefined}
  data-keywords={filterable ? keywords : undefined}
  data-tags={filterable ? JSON.stringify(metadata.tags) : undefined}
>
  <span class="rsi-package-icon"><UiIcon name="box" /></span>
  <div class="package-card-identity">
    <h3><a href={href}>{definition.name}</a></h3>
    <p class="package-id">{manifest.package_id}</p>
  </div>
  <span class="rsi-version">v{latest.version}</span>
  <div class="package-card-content">
    <p class="package-description">{metadata.summary}</p>
    <div class="package-card-meta">
      <span class="package-kind">{metadata.category}</span>
      {metadata.tags.length > 0 && (
        <ul class="tag-list" aria-label="标签">
          {metadata.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </div>
  </div>
</article>
