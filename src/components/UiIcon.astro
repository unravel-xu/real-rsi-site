  book: ['M4 5h5a3 3 0 0 1 3 3v12a4 4 0 0 0-3-2H4z', 'M20 5h-5a3 3 0 0 0-3 3v12a4 4 0 0 1 3-2h5z'],
  search: ['M16 10.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z', 'm15 15 5 5'],
  filter: ['M4 7h16M7 12h10m-7 5h4'],
  grid: ['M4 4h6v6H4zm10 0h6v6h-6zm0 10h6v6h-6zM4 14h6v6H4z'],
  list: ['M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01'],
  fork: ['M6 8v2a4 4 0 0 0 4 4h4a4 4 0 0 0 4-4V8M12 14v2', 'M8 6a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm12 0a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm-6 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0z'],
  download: ['M12 4v11m-4-4 4 4 4-4M5 16v4h14v-4'],
  data: ['M5 7c0-1.7 3.1-3 7-3s7 1.3 7 3-3.1 3-7 3-7-1.3-7-3zm0 0v5c0 1.7 3.1 3 7 3s7-1.3 7-3V7M5 12v5c0 1.7 3.1 3 7 3s7-1.3 7-3v-5'],
  play: ['m8 5 11 7-11 7z'],
  check: ['M5 12l4 4L19 6'],
  loop: ['M19 8H9a4 4 0 0 0 0 8h9m-4-4 4 4-4 4M19 8l-3-3m3 3-3 3'],
  tag: ['m4 5 7-.5 8.5 8.5-6.5 6.5L4.5 11 4 5zm4 3h.01'],
  chevron: ['m9 6 6 6-6 6'],
  chevronDown: ['m6 9 6 6 6-6'],
} as const;

interface Props {
  name: keyof typeof icons;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class:list={['rsi-icon', className]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {icons[name].map((path) => <path d={path} />)}
</svg>
