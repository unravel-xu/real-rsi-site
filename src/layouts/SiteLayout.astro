---
import ThemeProvider from '@astrojs/starlight/components/ThemeProvider.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { sitePath } from '../lib/links';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  section: 'home' | 'market';
}
const { title, description, section } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {Astro.response.status !== 404 && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <link rel="icon" href={sitePath('favicon.png')} />
    <title>{title}</title>
    <ThemeProvider />
  </head>
  <body class="rsi-site">
    <a class="rsi-skip" href="#main">跳到正文</a>
    <header class="rsi-header"><SiteNav section={section} /></header>
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
