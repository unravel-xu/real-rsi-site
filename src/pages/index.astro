---
import SiteLayout from '../layouts/SiteLayout.astro';
import PackageCard from '../components/PackageCard.astro';
import UiIcon from '../components/UiIcon.astro';
import WorkflowPreview from '../components/WorkflowPreview.astro';
import { loadCatalog } from '../lib/catalog.mjs';
import { sitePath } from '../lib/links';

const catalog = loadCatalog();
const gsm8k = catalog.find(({ owner, project }) => owner === 'real-rsi' && project === 'gsm8k-prompt');
const featured = gsm8k ?? catalog[0];
const guides = [
  { title: '导入 System 设计', description: '在 Panel 中打开 ZIP 或 system.json。', path: 'docs/import/', icon: 'download' },
  { title: '了解 GSM8K 示例', description: '查看 Workflow 与 CLI 复跑条件。', path: 'docs/gsm8k/', icon: 'book' },
  { title: '贡献你的配置', description: '导出设计并提交 GitHub PR。', path: 'docs/contribute/', icon: 'fork' },
] as const;
---

<SiteLayout
  title="real-rsi｜研究系统工作台"
  description="浏览 real-rsi 文档与社区 System 配置，下载设计并导入自己的 Panel。"
  section="home"
>
  <section class="rsi-container home-hero" aria-labelledby="home-title">
    <div class="home-intro">
      <h1 id="home-title">让研究设计<br />可以被复用。</h1>
      <p class="rsi-lead">把 Module、接口与 Workflow 组织成可审阅的 System。从社区下载一份设计，在你的 Panel 里继续做实验。</p>
      <div class="rsi-actions">
        <a class="rsi-button rsi-button-primary" href={sitePath('market/')}><UiIcon name="grid" />浏览配置市场</a>
        <a class="rsi-button" href={sitePath('docs/')}><UiIcon name="book" />阅读文档</a>
      </div>
    </div>

    <WorkflowPreview
      href={sitePath(gsm8k ? 'market/real-rsi/gsm8k-prompt/' : 'docs/gsm8k/')}
      version={gsm8k?.latest.version}
    />
  </section>

  <section class="home-start" aria-labelledby="resources-title">
    <div class="rsi-container home-resources">
      <div>
        <div class="rsi-section-heading">
          <h2 id="resources-title">从一个 System 开始</h2>
          <a class="rsi-text-link" href={sitePath('market/')}>查看全部配置</a>
        </div>
        {featured && <PackageCard project={featured} />}
      </div>
      <div>
        <h2 class="home-guides-title">使用指南</h2>
        <ul class="home-guide-list">
          {guides.map((guide) => (
            <li>
              <a href={sitePath(guide.path)}>
                <span class="guide-icon"><UiIcon name={guide.icon} /></span>
                <span class="guide-copy"><strong>{guide.title}</strong><small>{guide.description}</small></span>
                <UiIcon class="guide-chevron" name="chevron" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</SiteLayout>
